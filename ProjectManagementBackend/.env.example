# Application
APP_NAME=Project Management API
APP_VERSION=1.0.0
DEBUG=false

# PostgreSQL — password can contain @, #, etc. (no URL encoding needed)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pgadmin_password
POSTGRES_DB=projectmanagementtool

DEBUG=false

# JWT Authentication
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Microsoft login (same client ID as frontend VITE_MSAL_CLIENT_ID)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_TENANT_ID=organizations
ALLOWED_EMAIL_DOMAIN=aighospitals.com

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=aigprojectmanagement@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
